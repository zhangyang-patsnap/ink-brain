# 复制为 .env 后按环境填写。.env 已被 Git 排除，不要提交真实值。
# 启动后台（npm run admin）时读取；已存在的环境变量优先于本文件。

# 数据目录：草稿、上传文件、发布快照与作者密码都存在这里。
# 线上必须指向仓库之外的持久目录，否则 git pull、重新 clone 或切换部署目录会连带丢数据。
# 留空则回落到仓库根目录的 .inkbrain/，仅适合本地测试。
ADMIN_DATA_DIR=/var/lib/inkbrain

# 后台与站点的对外来源，不含末尾斜杠。必须与浏览器访问的地址完全一致。
ADMIN_ORIGIN=http://starkly.ink

# 监听地址与端口。有反向代理时保持 127.0.0.1；直接对外时才设 0.0.0.0。
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4322

# 首次初始化作者时使用的密码，至少 6 位。作者已存在后此项不再生效。
# 线上务必改掉，不要沿用仓库里的默认值。
ADMIN_PASSWORD=

# 生成 canonical、RSS 与 sitemap 的站点地址，默认等于 ADMIN_ORIGIN。
# SITE_URL=https://starkly.ink

# 访问统计是否信任 X-Forwarded-For 的最后一段（即直连反代自己追加的那一跳）
# 来获取真实客户端 IP。仅在确认所有外部流量必须经过唯一受控反向代理、且该
# 反代不可被绕过直连时才能设为 1；否则访客可自行伪造该头部把统计数字刷成任意值。
# 默认关闭，此时始终使用直连套接字地址（反代场景下会退化为按 UA 去重）。
# ADMIN_TRUST_PROXY=1
