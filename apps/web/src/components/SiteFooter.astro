import { siteMeta } from '../data/site';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-identity">
      <span class="footer-seal" aria-hidden="true">IB</span>
      <div>
        <strong>InkBrain</strong>
        <p>{siteMeta.tagline}</p>
      </div>
    </div>
    <nav aria-label="页脚导航">
      <a href="/writing/">归档</a>
      <a href="/knowledge/">索引</a>
      <a href="/projects/">项目</a>
      <a href="/tools/">工具</a>
      <a href="/about/">关于</a>
      <a href="/rss.xml">RSS</a>
    </nav>
    <div class="footer-stat" aria-label="累计访客">
      <span class="footer-stat-label">累计访客</span>
      <strong data-total-visitors>—</strong>
    </div>
    <p class="footer-meta">Built with clarity.<br />Written with evidence.</p>
  </div>
</footer>
<script>
  import { hydrateSiteTotal } from '../lib/visitor-stats';
  void hydrateSiteTotal();
