---
interface Props {
  index: number;
}

const { index } = Astro.props;
---

{/* 0 写作：蘸水笔尖（气孔 + 笔缝收于一点），对应「以墨为迹」 */}
{index === 0 && <svg viewBox="0 0 32 32"><path d="M11 4h10v11l-5 13-5-13V4Z"/><circle cx="16" cy="13" r="2"/><path d="M16 17v7"/></svg>}
{/* 1 专题：概念节点连成的折线图谱 */}
{index === 1 && <svg viewBox="0 0 32 32"><path d="m6 22 7-12 7 12 6-12"/><circle cx="6" cy="22" r="2"/><circle cx="13" cy="10" r="2"/><circle cx="20" cy="22" r="2"/><circle cx="26" cy="10" r="2"/></svg>}
{/* 2 项目：实验瓶 */}
{index === 2 && <svg viewBox="0 0 32 32"><path d="M11 5h10M13 5v8l-6 13h18l-6-13V5"/><path d="M10 22h12"/></svg>}
{/* 3 工具：扳手 */}
{index === 3 && <svg viewBox="0 0 32 32"><path d="M21.5 4a7 7 0 0 0-6.1 10.4L5 24.8 7.2 27l10.4-10.4A7 7 0 0 0 28 10.5l-3.9 3.9-3.5-3.5L24.5 7A7 7 0 0 0 21.5 4Z"/></svg>}
