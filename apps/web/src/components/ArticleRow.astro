---
import type { CollectionEntry } from 'astro:content';
import ArrowLink from './ArrowLink.astro';
import MaturityBadge from './MaturityBadge.astro';

interface Props {
  article: CollectionEntry<'articles'>;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
  .format(article.data.publishedAt);
---

<article class:list={['article-row', featured && 'article-row-featured']}>
  <div class="article-row-meta">
    <span>{article.data.topic}</span>
    <time datetime={article.data.publishedAt.toISOString()}>{date}</time>
  </div>
  <div class="article-row-body">
    <h2><a href={`/writing/${article.id}/`}>{article.data.title}</a></h2>
    <p>{article.data.summary}</p>
    <div class="article-row-foot">
      <MaturityBadge value={article.data.maturity} demo={article.data.demo} />
      <span>{article.data.readingMinutes} 分钟阅读</span>
      <ArrowLink href={`/writing/${article.id}/`} label="阅读全文" />
    </div>
  </div>
</article>
