---
import ArrowLink from '../../components/ArrowLink.astro';
import PageIntro from '../../components/PageIntro.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { frameworkTracks } from '../../data/frameworks';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Framework Labs — InkBrain"
  description="比较 AI 框架的定位、概念、实验方向和当前运行状态。"
  section="frameworks"
>
  <PageIntro
    title="Framework Labs"
    description="先理解框架解决什么，再决定值得验证什么。每个 Lab 保持独立运行边界，网页只展示诚实的当前状态。"
    index="LABS / 03"
    note="当前没有可运行 Lab；planned 与 documented 都不是 available。"
  />

  <section class="content-shell framework-table" aria-label="框架目录">
    {frameworkTracks.map((framework) => (
      <article class="framework-row">
        <h2><a href={`/frameworks/${framework.slug}/`}>{framework.name}</a></h2>
        <span class="framework-language">{framework.language}</span>
        <p>{framework.position}</p>
        <StatusBadge value={framework.status} />
        <ArrowLink href={`/frameworks/${framework.slug}/`} label="查看边界" />
      </article>
    ))}
  </section>
</BaseLayout>
