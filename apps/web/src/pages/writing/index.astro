---
import { getCollection } from 'astro:content';
import WritingHome from '../../components/WritingHome.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = await getCollection('articles');
---

<BaseLayout
  title="技术写作 — InkBrain"
  description="围绕 AI 应用架构、后端工程与运行时边界的技术文章。"
  section="writing"
  bodyClass="writing-index-page"
>
  <WritingHome articles={articles} />
</BaseLayout>
