---
import { getCollection } from 'astro:content';
import TopicExhibition from '../../components/TopicExhibition.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { topicCatalog } from '../../data/topic-content';
const entries = await getCollection('knowledge');
const catalog = await topicCatalog();
---
<BaseLayout title="专题 — InkBrain" description="按顺序阅读文章、探索项目、使用工具，从理解走向实践。" section="knowledge" bodyClass="topic-exhibition-page">
  <TopicExhibition entries={entries} catalog={catalog} />
</BaseLayout>
