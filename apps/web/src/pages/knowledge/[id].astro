---
import { getCollection } from 'astro:content';
import { topicCatalog } from '../../data/topic-content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicGuide from '../../components/TopicGuide.astro';
export async function getStaticPaths() {
  return (await getCollection('knowledge')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const catalog = await topicCatalog();
---
<BaseLayout title={`${entry.data.title} — 专题 — InkBrain`} description={entry.data.summary} section="knowledge" bodyClass="topic-guide-page">
  <TopicGuide entry={entry} catalog={catalog} />
</BaseLayout>
