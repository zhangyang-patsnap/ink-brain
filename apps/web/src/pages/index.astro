---
import { getCollection } from 'astro:content';
import ArrowLink from '../components/ArrowLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ownedProjects } from '../data/projects';
import { destinations, siteMeta } from '../data/site';
import { getArticleTag } from '../data/taxonomy';
import { softwareTools, toolKindLabels } from '../data/tools';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const knowledge = (await getCollection('knowledge')).sort((a, b) => a.data.order - b.data.order);
const featured = articles[0];
const featuredTag = featured?.data.tags[0] && getArticleTag(featured.data.tags[0]);
const featuredProject = ownedProjects[0];
const featuredTools = softwareTools.filter((tool) => tool.kind !== 'web-tool').slice(0, 3);
---

<BaseLayout section="home" bodyClass="home-page">
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">{siteMeta.tagline}</h1>
      <p>
        {siteMeta.intro.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}
      </p>
      <p class="hero-signature">By {siteMeta.author}</p>
      <div class="hero-entry-actions"><ArrowLink href="/writing/" label="开始阅读" /><a href="/projects/">看看我的项目</a></div>
    </div>

    <figure class="hero-visual" aria-label="水墨与知识节点组成的抽象网络">
      <img
        src="/images/inkbrain-knowledge-network.png"
        alt="水墨从左侧延伸为右侧的知识节点网络"
        width="1536"
        height="1024"
        fetchpriority="high"
      />
    </figure>

    <aside class="evidence-legend" aria-label="内容成熟度说明">
      <strong>Evidence maturity</strong>
      <ul>
        <li><span class="legend-mark legend-mark-idea"></span>idea · 构思</li>
        <li><span class="legend-mark legend-mark-studied"></span>studied · 已学习</li>
        <li><span class="legend-mark legend-mark-implemented"></span>implemented · 已实现</li>
        <li><span class="legend-mark legend-mark-verified"></span>verified · 已验证</li>
      </ul>
    </aside>
  </section>

  <section class="territory-section shell" aria-label="主要内容区域">
    <div class="territory-route" aria-hidden="true"><span></span></div>
    <div class="territories">
      {destinations.map((destination, index) => (
        <a class="territory" href={destination.href}>
          <span class="territory-id">
            <span>{destination.id}</span>
            <span class="territory-number">{String(index + 1).padStart(2, '0')}</span>
          </span>
          <h2>{destination.label}</h2>
          <p>{destination.description}</p>
        </a>
      ))}
    </div>

  </section>

  <section class="home-section shell" aria-labelledby="latest-content-title">
    <header class="section-header">
      <h2 id="latest-content-title">最新内容</h2>
      <p>先读一篇文章，再从专题进入完整的阅读与实践路径。</p>
    </header>

    <div class="home-editorial-grid">
      {featured && <article class="featured-article">
        <div class="featured-copy">
          <h3>{featured.data.title}</h3>
          <p>{featured.data.summary}</p>
          <div class="featured-meta">
            {featuredTag && <span>#{featuredTag.label}</span>}
            <span>{featured.data.readingMinutes} MIN READ</span>
          </div>
          <ArrowLink href={`/writing/${featured.id}/`} label="阅读全文" />
        </div>
        <div class="featured-visual" aria-hidden="true">
          <img src="/images/inkbrain-knowledge-network.png" alt="" width="1536" height="1024" loading="lazy" />
        </div>
      </article>}

      <section class="index-panel" aria-labelledby="topic-reading-title">
        <h3 id="topic-reading-title">专题阅读</h3>
        <ul class="relationship-list">
          {knowledge.map((entry, index) => (
            <li><a href={`/knowledge/${entry.id}/`}>{entry.data.title}</a><span>{entry.data.items.length} 项</span><span>{String(index + 1).padStart(2, '0')}</span></li>
          ))}
        </ul>
        <ArrowLink href="/knowledge/" label="查看全部专题" />
      </section>
    </div>
  </section>

  <section class="home-section shell" aria-labelledby="build-register-title">
    <header class="section-header">
      <h2 id="build-register-title">项目与工具</h2>
      <p>这里记录自研项目，也提供可以直接获取和使用的小型工具。</p>
    </header>
    <div class="home-build-grid">
      {featuredProject && <article class="home-project-feature">
        <div class="catalog-eyebrow"><span>OWNED PROJECT</span><span>{featuredProject.demo ? 'DEMO' : featuredProject.status.toUpperCase()}</span></div>
        <h3>{featuredProject.name}</h3><p>{featuredProject.tagline}</p>
        <div class="stack-register">{featuredProject.stack.map((item) => <span>{item}</span>)}</div>
        <ArrowLink href={`/projects/${featuredProject.slug}/`} label="了解项目" />
      </article>}
      <section class="home-tool-register" aria-labelledby="home-tools-title">
        <h3 id="home-tools-title">SOFTWARE MARKET</h3>
        <ul>{featuredTools.map((tool) => <li><div><span>{toolKindLabels[tool.kind]}</span><a href={`/tools/${tool.slug}/`}>{tool.name}</a></div><small>{tool.release.version}</small><strong>{tool.availability.toUpperCase()}</strong></li>)}</ul>
        <ArrowLink href="/tools/" label="打开工具市场" />
      </section>
    </div>
  </section>
</BaseLayout>
