---
import { getCollection } from 'astro:content';
import ArrowLink from '../components/ArrowLink.astro';
import TerritoryBand from '../components/TerritoryBand.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { frameworkTracks } from '../data/frameworks';
import { ownedProjects } from '../data/projects';
import { homeMeta, siteMeta } from '../data/site';
import { getArticleTag } from '../data/taxonomy';
import { softwareTools, toolKindLabels } from '../data/tools';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const knowledge = (await getCollection('knowledge')).sort((a, b) => a.data.order - b.data.order);
const featured = articles[0];
const featuredProject = ownedProjects[0];
const featuredTools = softwareTools.filter((tool) => tool.kind !== 'web-tool').slice(0, 3);
const dateFormat = new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium' });

const relationshipIndex = [
  { label: '知识专题', value: knowledge.length },
  { label: '技术文章', value: articles.length },
  { label: '自研项目', value: ownedProjects.length },
  { label: '工具发布', value: softwareTools.length },
  { label: '框架研究', value: frameworkTracks.length },
];
---

<BaseLayout section="home" bodyClass="home-page">
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-eyebrow">{homeMeta.eyebrow}</p>
      <h1 id="hero-title">{siteMeta.tagline}</h1>
      <p class="hero-intro">
        {siteMeta.intro.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}
      </p>
      <p class="hero-signature">By {siteMeta.author}<span>{homeMeta.authorRole}</span></p>
      <div class="hero-entry-actions">
        <ArrowLink href="/writing/" label="开始阅读" />
        <a href="/projects/">看看我的项目</a>
      </div>
    </div>

    <figure class="hero-visual" aria-label="水墨与知识节点组成的抽象网络">
      <img
        src="/images/inkbrain-knowledge-network.png"
        alt="水墨从左侧延伸为右侧的知识节点网络"
        width="1536"
        height="1024"
        fetchpriority="high"
      />
    </figure>

  </section>

  <TerritoryBand variant="b" />

  <section class="home-section shell" aria-labelledby="latest-content-title">
    <header class="section-header">
      <h2 id="latest-content-title">最新内容</h2>
      <p>先读一篇文章，再从专题进入完整的阅读与实践路径。</p>
    </header>

    <div class="home-editorial-grid">
      {featured && <article class="featured-article">
        <div class="featured-copy">
          <p class="catalog-eyebrow"><span>FEATURED ARTICLE</span><span>精选文章</span></p>
          <h3>{featured.data.title}</h3>
          <p class="featured-summary">{featured.data.summary}</p>
          <div class="featured-tags">
            {featured.data.tags.map((tag) => {
              const meta = getArticleTag(tag);
              return meta ? <a href={`/writing/tag/${meta.slug}/`}>{meta.label}</a> : null;
            })}
          </div>
          <div class="featured-meta">
            <span>{dateFormat.format(featured.data.publishedAt)}</span>
            <span>{featured.data.readingMinutes} 分钟阅读</span>
          </div>
          <ArrowLink href={`/writing/${featured.id}/`} label="阅读全文" />
        </div>
        <div class="featured-visual" aria-hidden="true">
          <img src="/images/inkbrain-knowledge-network.png" alt="" width="1536" height="1024" loading="lazy" />
        </div>
      </article>}

      <section class="index-panel" aria-labelledby="topic-reading-title">
        <p class="catalog-eyebrow"><span>RELATIONSHIP INDEX</span></p>
        <h3 id="topic-reading-title">内容索引</h3>
        <ul class="relationship-list">
          {relationshipIndex.map((entry) => (
            <li><span>{entry.label}</span><span>{entry.value}</span></li>
          ))}
        </ul>
        <ArrowLink href="/knowledge/" label="探索全部专题" />
      </section>

      <aside class="statement-panel" aria-label="站点主张">
        <blockquote>{homeMeta.statement.quote}</blockquote>
        <cite>{homeMeta.statement.cite}</cite>
      </aside>
    </div>
  </section>

  <section class="home-section shell" aria-labelledby="build-register-title">
    <header class="section-header">
      <h2 id="build-register-title">项目与工具</h2>
      <p>这里记录自研项目，也提供可以直接获取和使用的小型工具。</p>
    </header>
    <div class="home-build-grid">
      {featuredProject && <article class="home-project-feature">
        <div class="catalog-eyebrow"><span>OWNED PROJECT</span><span>{featuredProject.demo ? 'DEMO' : featuredProject.status.toUpperCase()}</span></div>
        <h3>{featuredProject.name}</h3>
        <p>{featuredProject.tagline}</p>
        <div class="stack-register">{featuredProject.stack.map((item) => <span>{item}</span>)}</div>
        <ArrowLink href={`/projects/${featuredProject.slug}/`} label="了解项目" />
      </article>}
      <section class="home-tool-register" aria-labelledby="home-tools-title">
        <h3 id="home-tools-title">SOFTWARE MARKET</h3>
        <ul>{featuredTools.map((tool) => <li><div><span>{toolKindLabels[tool.kind]}</span><a href={`/tools/${tool.slug}/`}>{tool.name}</a></div><small>{tool.release.version}</small><strong>{tool.availability.toUpperCase()}</strong></li>)}</ul>
        <ArrowLink href="/tools/" label="打开工具市场" />
      </section>
    </div>
  </section>

</BaseLayout>
